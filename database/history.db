medlink=# CREATE OR REPLACE FUNCTION update_updated_at_column()
medlink-# RETURNS TRIGGER
medlink-# AS $$
medlink$# BEGIN
medlink$#     NEW.updated_at = CURRENT_TIMESTAMP;
medlink$#     RETURN NEW;
medlink$# END;
medlink$# $$ LANGUAGE plpgsql;
CREATE FUNCTION
medlink=# CREATE TRIGGER trg_users_updated_at
medlink-# BEFORE UPDATE ON users
medlink-# FOR EACH ROW
medlink-# EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER
