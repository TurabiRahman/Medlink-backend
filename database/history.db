medlink=# CREATE TABLE hospitals (
medlink(#
medlink(#     id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
medlink(#
medlink(#     hospital_name VARCHAR(255) NOT NULL,
medlink(#
medlink(#     license_number VARCHAR(100) NOT NULL UNIQUE,
medlink(#
medlink(#     email VARCHAR(255) NOT NULL UNIQUE,
medlink(#
medlink(#     phone VARCHAR(20) NOT NULL UNIQUE,
medlink(#
medlink(#     website VARCHAR(255),
medlink(#
medlink(#     address TEXT NOT NULL,
medlink(#
medlink(#     latitude NUMERIC(9,6) NOT NULL
medlink(#         CHECK (latitude BETWEEN -90 AND 90),
medlink(#
medlink(#     longitude NUMERIC(9,6) NOT NULL
medlink(#         CHECK (longitude BETWEEN -180 AND 180),
medlink(#
medlink(#     hospital_status hospital_status_type NOT NULL DEFAULT 'OPEN',
medlink(#
medlink(#     description TEXT,
medlink(#
medlink(#     created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
medlink(#
medlink(#     updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
medlink(#
medlink(# );
CREATE TABLE
