medlink-# BEFORE UPDATE ON hospitals
medlink-# FOR EACH ROW
medlink-# EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER
medlink=# \d hospitals;
                                     Table "public.hospitals"
     Column      |           Type           | Collation | Nullable |           Default
-----------------+--------------------------+-----------+----------+------------------------------
 id              | uuid                     |           | not null | gen_random_uuid()
 hospital_name   | character varying(255)   |           | not null |
 license_number  | character varying(100)   |           | not null |
 email           | character varying(255)   |           | not null |
 phone           | character varying(20)    |           | not null |
 website         | character varying(255)   |           |          |
 address         | text                     |           | not null |
 latitude        | numeric(9,6)             |           | not null |
 longitude       | numeric(9,6)             |           | not null |
 hospital_status | hospital_status_type     |           | not null | 'OPEN'::hospital_status_type
 description     | text                     |           |          |
 created_at      | timestamp with time zone |           | not null | CURRENT_TIMESTAMP
 updated_at      | timestamp with time zone |           | not null | CURRENT_TIMESTAMP
Indexes:
    "hospitals_pkey" PRIMARY KEY, btree (id)
    "hospitals_email_key" UNIQUE CONSTRAINT, btree (email)
