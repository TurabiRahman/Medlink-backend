 user_id                   | uuid                     |           | not null |
 blood_group               | blood_group_type         |           | not null |
 last_donation_date        | date                     |           |          |
 can_donate                | boolean                  |           | not null | true
 next_available_date       | date                     |           |          |
 is_available_for_donation | boolean                  |           | not null | true
 updated_at                | timestamp with time zone |           | not null | CURRENT_TIMESTAMP
Indexes:
    "blood_information_pkey" PRIMARY KEY, btree (id)
    "blood_information_user_id_key" UNIQUE CONSTRAINT, btree (user_id)
Foreign-key constraints:
    "fk_blood_information_user" FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
Triggers:
    trg_blood_information_updated_at BEFORE UPDATE ON blood_information FOR EACH ROW EXECUTE FUNCTION update_updated_at_column()