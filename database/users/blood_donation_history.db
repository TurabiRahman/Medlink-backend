| Column        | Type        | Why?                             |
| ------------- | ----------- | -------------------------------- |
| id            | UUID        | Primary Key                      |
| user_id       | UUID        | Donor                            |
| hospital_id   | UUID        | Hospital where donation occurred |
| donation_date | DATE        | Donation date                    |
| remarks       | TEXT        | Optional notes                   |
| created_at    | TIMESTAMPTZ | Record creation                  |

CREATE TABLE blood_donation_history (

    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    user_id UUID NOT NULL,

    hospital_id UUID,

    donation_date DATE NOT NULL,

    remarks TEXT,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_blood_donation_history_user
        FOREIGN KEY (user_id)
        REFERENCES users(id)
        ON DELETE CASCADE

);


