| Column     | Type         | Why?                             |
| ---------- | ------------ | -------------------------------- |
| id         | UUID         | Primary Key                      |
| user_id    | UUID         | One location belongs to one user |
| latitude   | NUMERIC(9,6) | GPS Latitude                     |
| longitude  | NUMERIC(9,6) | GPS Longitude                    |
| updated_at | TIMESTAMPTZ  | Last location update             |


CREATE TABLE user_locations (

    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    user_id UUID NOT NULL UNIQUE,

    latitude NUMERIC(9,6) NOT NULL,

    longitude NUMERIC(9,6) NOT NULL,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_user_locations_user
        FOREIGN KEY (user_id)
        REFERENCES users(id)
        ON DELETE CASCADE

);

# Trigger for this table 

CREATE TRIGGER trg_user_locations_updated_at
BEFORE UPDATE ON user_locations
FOR EACH ROW
EXECUTE FUNCTION update_updated_at_column();

# After execution

medlink=# \d user_locations;
